import 'package:cellphone_doctor/screens/CourseView/controller/course_controller.dart';
import 'package:flutter/material.dart';
import 'package:flutter_widget_from_html/flutter_widget_from_html.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:get/get.dart';
import 'package:get/get_core/src/get_main.dart';
import 'package:get/get_state_manager/src/simple/get_state.dart';
import 'package:video_player/video_player.dart';

import '../../utils/app_colors.dart';
import '../../widgets/course_confirm.dart';

class CourseView extends StatelessWidget {
  const   CourseView({super.key});

  @override
  Widget build(BuildContext context) {
    Size size = MediaQuery.sizeOf(context);
    return GetBuilder<CourseController>(
      init: CourseController(),
      builder: (controller) {
        return Scaffold(
          appBar: AppBar(
            title: const Text("Course"),
          ),
          body: SingleChildScrollView(
            physics: BouncingScrollPhysics(),
            child: Padding(
              padding: EdgeInsets.symmetric(horizontal: 8.w),
              child: Column(
                children: [
                  Container(
                    height: size.height * 0.25,
                    width: size.width,
                    child: (controller.isInitialized &&
                            controller.videoController != null)
                        ? Stack(
                            alignment: Alignment.center,
                            children: [
                              ClipRRect(
                                borderRadius: BorderRadius.circular(10),
                                child: SizedBox(
                                  width: double.infinity,
                                  height: double.infinity,
                                  child: FittedBox(
                                    fit: BoxFit.cover,
                                    child: SizedBox(
                                      width: controller
                                          .videoController!
                                          .value
                                          .size
                                          .width,
                                      height: controller
                                          .videoController!
                                          .value
                                          .size
                                          .height,
                                      child: VideoPlayer(
                                        controller.videoController!,
                                      ),
                                    ),
                                  ),
                                ),
                              ),
                              if (!controller.isPlaying)
                                GestureDetector(
                                  onTap: controller.togglePlay,
                                  child: Container(
                                    decoration: BoxDecoration(
                                      color: Colors.blue.withOpacity(0.3),
                                      shape: BoxShape.circle,
                                    ),
                                    child: const Icon(
                                      Icons.play_arrow_rounded,
                                      color: Colors.white,
                                      size: 55,
                                    ),
                                  ),
                                )
                              else
                                GestureDetector(
                                  onTap: controller.togglePlay,
                                  child: Container(
                                    color: Colors.transparent,
                                    height: size.height * 0.25,
                                    width: size.width * 0.9,
                                  ),
                                ),
                            ],
                          )
                        : Container(
                            decoration: BoxDecoration(
                              color: Colors.grey.shade300,
                              borderRadius: BorderRadius.circular(10),
                            ),
                            alignment: Alignment.center,
                            child: controller.isLoadingVideo
                                ? const CircularProgressIndicator()
                                : const Text("No Course Video Available"),
                          ),
                  ),

                  SizedBox(height: 16.h),

                  Text(
                    "We provide advanced Mobile Service Chip Level Training course in Chennai. Our range of advanced syllabus gives you an in depth knowledge of the course and makes you job ready. We have qualified staffs and infrastructure for the Mobile and Tablet Repairing courses. Below are the details of the syllabus we cover for the course.",
                    textAlign: TextAlign.justify,
                    style: TextStyle(
                      color: Colors.black87,
                      fontSize: 14.sp,
                      height: 1.5,
                    ),
                  ),

                  SizedBox(height: 20.h),

                  Center(
                    child: Image.asset(
                      "assets/images/course_img.png",
                      width: size.width * 0.85,
                      fit: BoxFit.contain,
                    ),
                  ),


                  SizedBox(height: 15.h),

                  /// Grid of Reusable Cards
                  GridView.builder(
                    shrinkWrap: true,
                    physics: const NeverScrollableScrollPhysics(),
                    itemCount: controller.whyChooseUsList.length,
                    gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
                      crossAxisCount: 2,
                      mainAxisSpacing: 12.h,
                      crossAxisSpacing: 12.w,
                      childAspectRatio: 1.5,
                    ),
                    itemBuilder: (context, index) {
                      final item = controller.whyChooseUsList[index];
                      return WhyChooseCard(
                        title: item["title"],
                        icon: item["icon"],
                      );
                    },
                  ),

                  SizedBox(height: 20.h),

                  Text(
                    "Mobile Repairing Courses",
                    style: TextStyle(
                      fontSize: 18.sp,
                      fontWeight: FontWeight.w700,
                      color: Colors.black,
                    ),
                  ),
                  SizedBox(height: 12.h),

                  controller.isLoading
                      ? const Center(child: CircularProgressIndicator())
                      : SingleChildScrollView(
                          scrollDirection: Axis.horizontal,
                          padding: EdgeInsets.symmetric(horizontal: 22.w),
                          child: Row(
                            children: List.generate(
                              controller.courses.length,
                              (index) {
                                bool isSelected =
                                    controller.selectedTab == index;
                                return GestureDetector(
                                  onTap: () => controller.changeTab(index),
                                  child: Container(
                                    padding: EdgeInsets.only(right: 20.w),
                                    child: Column(
                                      mainAxisAlignment:
                                          MainAxisAlignment.spaceEvenly,
                                      children: [
                                        Text(
                                          controller.courses[index].title ?? "",
                                          style: TextStyle(
                                            fontSize: 20.sp,
                                            fontWeight: isSelected
                                                ? FontWeight.w700
                                                : FontWeight.w500,
                                            color: isSelected
                                                ? Colors.black
                                                : Colors.black87,
                                          ),
                                        ),
                                        SizedBox(height: 4.h),
                                        AnimatedContainer(
                                          duration:
                                              const Duration(milliseconds: 250),
                                          height: 3.h,
                                          width: isSelected ? 40.w : 0,
                                          decoration: BoxDecoration(
                                            color: Colors.blue,
                                            borderRadius:
                                                BorderRadius.circular(10.r),
                                          ),
                                        ),
                                      ],
                                    ),
                                  ),
                                );
                              },
                            ),
                          ),
                        ),

                  SizedBox(height: 18.h),

                  // /// 🔹 Banner
                  // ClipRRect(
                  //   borderRadius: BorderRadius.circular(10.r),
                  //   child: Image.asset(
                  //     "assets/course/course_banner.png",
                  //     height: 120.h,
                  //     width: double.infinity,
                  //     fit: BoxFit.cover,
                  //   ),
                  // ),

                  SizedBox(height: 18.h),

                  Text(
                    "Course Description",
                    style: TextStyle(
                      fontSize: 16.sp,
                      fontWeight: FontWeight.w700,
                      color: Colors.black,
                    ),
                  ),
                  SizedBox(height: 10.h),

                  if (!controller.isLoading && controller.courses.isNotEmpty)
                    SizedBox(
                      height: 380.h,
                      child: PageView.builder(
                        controller: controller.pageController,
                        physics: const BouncingScrollPhysics(),
                        onPageChanged: controller.updatePage,
                        itemCount: controller.courses.length,
                        itemBuilder: (context, index) {
                          return SingleChildScrollView(
                            padding: const EdgeInsets.only(bottom: 20),
                            physics: const BouncingScrollPhysics(),
                            child: HtmlWidget(
                              controller.courses[index].description ?? "",
                              textStyle: TextStyle(
                                fontSize: 14.sp,
                                color: Colors.black87,
                                height: 1.3,
                              ),
                            ),
                          );
                        },
                      ),
                    )
                  else
                    const SizedBox(),

                  SizedBox(height: 20.h),

                  SizedBox(
                    width: double.infinity,
                    height: 48.h,
                    child: ElevatedButton(
                      onPressed: () {
                        showDetailsDialog(context);
                      },
                      style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.blue,
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(25.r),
                        ),
                      ),
                      child: Text(
                        "Join Now",
                        style: TextStyle(
                          color: Colors.white,
                          fontSize: 16.sp,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ),
                  ),


                  SizedBox(height: 130.h),

                ],
              ),
            ),
          ),
        );
      },
    );
  }
}

//reusable card

class WhyChooseCard extends StatelessWidget {
  final String title;
  final IconData icon;

  const WhyChooseCard({
    super.key,
    required this.title,
    required this.icon,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.black,
        borderRadius: BorderRadius.circular(12.r),
        boxShadow: [
          BoxShadow(
            color: Colors.black.withOpacity(0.1),
            blurRadius: 6,
            offset: const Offset(0, 3),
          ),
        ],
      ),
      padding: EdgeInsets.symmetric(horizontal: 14.w, vertical: 12.h),
      child: Stack(
        children: [

          Positioned(
            top: 8.h,
            left: 8.w,
            right: 8.w,
            child: Text(
              title,
              style: TextStyle(
                color: Colors.white,
                fontSize: 15.sp,
                fontWeight: FontWeight.w700,
                height: 1.3,
              ),
            ),
          ),
          Positioned(
            bottom: 8.h,
            right: 10.w,
            child: Icon(
              icon,
              color: Colors.blue,
              size: 35.sp,
            ),
          ),
        ],
      ),
    );
  }
}
